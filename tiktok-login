<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Connecting...</title>
    <script>
        window.onload = function() {
            // Re-trigger the exact URL TikTok gave us
            // This is the most "elegant" way to trigger the AppDelegate
            window.location.replace(window.location.href);
            
            // If it doesn't jump in 1 second, reload once to be sure
            setTimeout(function() {
                window.location.reload();
            }, 1000);
        };
    </script>
</head>
<body style="font-family: -apple-system; text-align: center; padding-top: 50px;">
    <h3>Finalizing Login...</h3>
</body>
</html>
